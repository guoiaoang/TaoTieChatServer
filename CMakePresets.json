    "packagePresets": [
        {
            "name": "base-windows-debug-package",
            "displayName": "debug package",
            "description": "debug package for windows",
            "condition":
            {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            },
            "configurePreset": "base-windows-debug-configure",
            "configurations": [
                "Debug"
            ],
            "generators": [
                "ZIP"
            ]
        },
        {
            "name": "base-windows-release-package",
            "displayName": "release package",
            "description": "release package for windows",
            "condition":
            {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            },
            "configurePreset": "base-windows-release-configure",
            "configurations": [
                "Release"
            ],
            "generators": [
                "ZIP"
            ]
        },
        {
            "$comment": [
                "需要的依赖未完整包含，因此暂不启用。"
            ],
            "name": "base-linux-debug-package",
            "displayName": "debug package",
            "description": "debug package for linux",
            "hidden": true,
            "condition":
            {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            },
            "configurePreset": "base-linux-debug-configure",
            "configurations": [
                "Debug"
            ],
            "generators": [
                "TGZ"
            ]
        },
        {
            "$comment": [
