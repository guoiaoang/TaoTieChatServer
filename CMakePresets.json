            ],
            "name": "base-linux-release-package",
            "displayName": "release package",
            "description": "release package for linux",
            "hidden": true,
            "condition":
            {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            },
            "configurePreset": "base-linux-release-configure",
