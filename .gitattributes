# 添加该文件是为了防止实际内容无变更但 git 提示有变更的情况
#
# 文件规则：
# 1. 源码与工程文件统一 LF（如 cpp/h/ui/qrc/ts/json/proto/cmake/md/txt）
# 2. Windows 脚本保留 CRLF（bat/cmd）
# 3. 图片、字体、qm 等资源按二进制处理，避免误判文本差异
# 你看到的这条警告是正常现象：
# 1. 在工作区里 .gitattributes 可能是 CRLF
# 2. 由于规则要求 LF，Git 提示“下次接触时会替换为 LF”
# 3. 不影响提交结果，索引会按规则保存

# Normalize text files by default.
* text=auto

# Source and project files should use LF.
*.c text eol=lf
*.cc text eol=lf
*.cpp text eol=lf
*.h text eol=lf
*.hh text eol=lf
*.hpp text eol=lf
*.inl text eol=lf
*.proto text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf
CMakePresets.json text eol=lf
vcpkg.json text eol=lf

# Qt and markup/config files use LF.
*.ui text eol=lf
*.qrc text eol=lf
*.ts text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.txt text eol=lf

# Windows command scripts keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.bmp binary
*.svg binary
*.ttf binary
*.otf binary
*.qm binary
*.dll binary
*.exe binary
