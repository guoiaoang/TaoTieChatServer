{
    "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
    "builtin-baseline": "9842d45d567ba785627932cca506615b4e43ae6e",
    "description": "Simple chat server based on the Google GRPC API.",
    "name": "taotiechatserver",
    "version-string": "0.1.0",
    "dependencies": [
        "abseil",
        "protobuf",
        "grpc",
        "gflags",
        "glog",
        "gtest",
        "benchmark",
        "fmt",
        "nlohmann-json",
        "yaml-cpp",
        "spdlog",
        "boost-uuid",
        "boost-dll",
        "boost-program-options",
        "stduuid",
        "hash-library",
        { "name": "sqlcipher", "platform": "windows & !uwp & !static" }
    ],
    "features": {
        "vcpkg-qt": {
            "description": "Use Qt libraries from vcpkg",
            "dependencies": [
                { "name": "abseil"               , "version>=": "20250127.0"},
                { "name": "protobuf"             , "version>=": "5.29.3"    },
                { "name": "grpc"                 , "version>=": "1.71.0"    },
                { "name": "gflags"               , "version>=": "2.2.2"     },
                { "name": "glog"                 , "version>=": "0.7.1"     },
                { "name": "gtest"                , "version>=": "1.16.0"    },
                { "name": "benchmark"            , "version>=": "1.9.2"     },
                { "name": "fmt"                  , "version>=": "11.0.2"    },
                { "name": "nlohmann-json"        , "version>=": "3.11.3"    },
                { "name": "yaml-cpp"             , "version>=": "0.8.0"     },
                { "name": "spdlog"               , "version>=": "1.15.2"    },
                { "name": "boost-uuid"           , "version>=": "1.87.0"    },
                { "name": "boost-dll"            , "version>=": "1.87.0"    },
                { "name": "boost-program-options", "version>=": "1.87.0"    },
                { "name": "stduuid"              , "version>=": "1.2.3"     },
                { "name": "hash-library"         , "version>=": "8"         },
                { "name": "sqlcipher"            , "version>=": "4.6.1", "platform": "windows & !uwp & !static" }
            ]
        }
    }
}